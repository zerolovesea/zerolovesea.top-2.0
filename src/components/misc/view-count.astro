---
// Client-side view counter. Derives the canonical slug from the URL path
// (strips the /en/ prefix and slashes) so the Chinese and English versions of
// the same post share one counter.
---
<p
	data-view-count
	class='text-start text-gray-500 font-medium'
	aria-label='view count'
	title='view count'>
	… reads
</p>

<script>
	(async () => {
		const el = document.querySelector("[data-view-count]");
		if (!el) return;

		const OPTOUT_KEY = "view_optout";
		let optedOut = false;
		let visitorId: string | null = null;
		try {
			// Opt out via a secret URL: /?noread=1 (or any page with ?noread=1).
			// Sets both localStorage and a cookie so the worker can skip server-side too.
			const params = new URLSearchParams(window.location.search);
			if (params.get("noread") === "1") {
				localStorage.setItem(OPTOUT_KEY, "1");
				document.cookie = `${OPTOUT_KEY}=1; max-age=31536000; path=/; samesite=lax`;
				const clean = new URL(window.location.href);
				clean.searchParams.delete("noread");
				history.replaceState(null, "", clean);
			}

			optedOut =
				localStorage.getItem(OPTOUT_KEY) === "1" ||
				document.cookie.includes(`${OPTOUT_KEY}=1`);

			// Anonymous visitor id (persisted) so the dashboard can separate
			// 访问次数 (visits) from 独立访客 (unique visitors).
			const VISITOR_KEY = "viewer_id";
			visitorId = localStorage.getItem(VISITOR_KEY);
			if (!visitorId) {
				visitorId =
					crypto.randomUUID?.() ??
					`v-${Math.random().toString(36).slice(2)}${Date.now().toString(36)}`;
				localStorage.setItem(VISITOR_KEY, visitorId);
			}
		} catch {
			// A blocked browser store must not prevent reading the public count.
			optedOut = true;
		}

		// Canonical slug: "/en/写在第一天/" and "/写在第一天/" both -> "写在第一天".
		let slug = window.location.pathname
			.replace(/^\/en(?=\/|$)/, "")
			.replace(/^\/+|\/+$/g, "");
		try {
			slug = decodeURIComponent(slug);
		} catch {}

		const render = (n: number) => {
			el.textContent = `${n} reads`;
		};

		const requestCount = async (increment: boolean) => {
			const response = await fetch(increment ? "/api/view" : `/api/view?slug=${encodeURIComponent(slug)}`, {
				...(increment ? {
					method: "POST",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({ slug, visitorId }),
					keepalive: true,
				} : {}),
				signal: AbortSignal.timeout(8000),
			});
			if (!response.ok) throw new Error(`view count: HTTP ${response.status}`);
			const data = await response.json();
			if (!data || typeof data !== "object" || !("count" in data) || typeof data.count !== "number" || !Number.isSafeInteger(data.count) || data.count < 0) throw new Error("invalid view count");
			return data.count;
		};
		try {
			render(await requestCount(!optedOut));
		} catch {
			// Never retry an increment: the first POST may already have counted it.
			if (!optedOut) {
				try { render(await requestCount(false)); return; } catch {}
			}
			el.textContent = "reads unavailable";
			el.setAttribute("title", "访问次数暂时无法读取，请稍后刷新");
		}
	})();
</script>
