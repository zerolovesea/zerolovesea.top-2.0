---
import { Header, ReadingAnalytics, ViewCount } from "@components/misc";
import FormattedDate from "@components/misc/formatted-date.astro";
import { BaseHead } from "@components/seo";
import RootLayout from "@layouts/root-layout.astro";
import { clsx } from "@utils/index";

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	readingTime?: number;
}

const { title, description, pubDate, updatedDate, readingTime } = Astro.props;
---

<html lang='en'>
	<head>
		<BaseHead
			title={title}
			description={description}
			type='article'
			publishedTime={pubDate}
			modifiedTime={updatedDate}
		/>
	</head>

	<RootLayout>
		<div
			id='navbar+title'
			class='flex flex-col w-full gap-6 max-w-xl'>
			<Header />

			<article
				id='blog-content'
				class='w-full flex flex-col gap-6 items-center justify-center'>
				<h1
					class='w-full max-w-xl text-4xl md:text-5xl lg:text-7xl font-medium tracking-tight'>
					{title}
				</h1>
				<div class='flex flex-row gap-2 w-full max-w-xl'>
					<p class='text-start text-gray-500 font-medium'>
						<FormattedDate date={pubDate.toString()} />
					</p>
					<span class='text-gray-500 font-medium'>·</span>
					<p class='text-start text-gray-500 font-medium'>
						{readingTime} min read
					</p>
					<span class='text-gray-500 font-medium'>·</span>
					<ViewCount />
				</div>
				<p
					class='w-full max-w-xl text-start font-medium text-gray-700 dark:text-gray-300 text-lg leading-relaxed'>
					<span class='font-semibold text-gray-900 dark:text-white'
						>tl;dr:
					</span>
					{description}
				</p>
				<div
					class={clsx(
						'relative max-w-xl',
						'w-full max-w-none prose prose-lg leading-relaxed my-3 prose-p:font-medium dark:prose-invert prose-a:underline prose-a:bg-orange-50 prose-a:decoration-orange-500 items-center justify-center',
						'dark:prose-a:bg-orange-950 dark:prose-a:decoration-orange-400 dark:prose-a:underline',
						'prose-h1:font-medium prose-h2:font-medium prose-h3:font-medium prose-h4:font-medium prose-h5:font-medium prose-h6:font-medium',
						'prose-h1:tracking-tight prose-h2:tracking-tight prose-h3:tracking-tight prose-h4:tracking-tight prose-h5:tracking-tight prose-h6:tracking-tight',
						'prose-ul:font-medium prose-ol:font-medium prose-li:font-medium',
						'prose-ul:space-y-3 prose-ol:space-y-3 prose-li:space-y-3',
						'prose-img:rounded-lg prose-img:my-8 prose-img:max-w-full prose-img:h-auto',
						'[&_:not(pre)>code]:bg-neutral-100 [&_:not(pre)>code]:dark:bg-neutral-800 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded-md [&_:not(pre)>code]:text-[0.9em] [&_:not(pre)>code]:font-normal [&_:not(pre)>code]:before:content-none [&_:not(pre)>code]:after:content-none',
						'[&_img]:max-w-full [&_img]:h-auto [&_img]:w-auto'
					)}>
					<slot />
				</div>
			</article>
			<dialog id="image-lightbox" aria-label="image preview" tabindex="-1">
				<div class="image-lightbox-controls">
					<button type="button" data-close aria-label="close image preview" title="close">
						<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="m6 6 12 12M18 6 6 18" />
						</svg>
					</button>
				</div>
				<figure>
					<img id="image-lightbox-preview" alt="" />
					<figcaption id="image-lightbox-caption" hidden></figcaption>
				</figure>
			</dialog>
		</div>
	</RootLayout>
	<ReadingAnalytics />

	<style is:global>
		#blog-content .prose :is(h2, h3, h4)[id] {
			position: relative;
			cursor: pointer;
		}

		#blog-content .prose :is(h2, h3, h4)[id]::after {
			content: '#';
			position: absolute;
			left: -1.5rem;
			opacity: 0;
			color: rgb(163 163 163);
			transition: opacity 0.15s;
		}

		#blog-content .prose :is(h2, h3, h4)[id]:hover::after {
			opacity: 1;
		}

		#blog-content .prose .image-gallery {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
			gap: 0.75rem;
			margin: 2rem 0;
		}

		#blog-content .prose .image-gallery a {
			background: none;
		}

		#blog-content .prose .image-gallery img {
			width: 100%;
			height: 10rem;
			margin: 0;
			object-fit: cover;
			transition: opacity 150ms ease;
		}

		#blog-content .prose .image-gallery a:hover img {
			opacity: 0.8;
		}

		#blog-content .prose .image-gallery img,
		#blog-content .prose > p > img {
			cursor: zoom-in;
		}

		#image-lightbox {
			position: fixed;
			inset: 0;
			width: fit-content;
			height: fit-content;
			margin: auto;
			max-width: min(90vw, 72rem);
			padding: 0.75rem;
			border: 1px solid var(--color-border-strong);
			border-radius: 0.5rem;
			background: var(--color-bg);
			color: var(--color-text);
		}

		#image-lightbox[open] {
			animation: image-lightbox-in 150ms ease-out;
		}

		#image-lightbox.is-closing {
			animation: image-lightbox-out 120ms ease-in forwards;
		}

		#image-lightbox::backdrop {
			background: rgb(0 0 0 / 70%);
		}

		html.image-lightbox-open {
			overflow: hidden;
		}

		#image-lightbox .image-lightbox-controls {
			display: flex;
			justify-content: flex-end;
			margin-bottom: 0.5rem;
		}

		#image-lightbox button {
			display: grid;
			place-items: center;
			width: 2rem;
			height: 2rem;
			border-radius: 0.25rem;
			border: 0;
			color: var(--color-text-secondary);
			transition: background-color 150ms ease, color 150ms ease;
		}

		#image-lightbox button:hover {
			background: var(--color-border);
			color: var(--color-text);
		}

		#image-lightbox button:focus-visible {
			outline: 2px solid var(--color-text);
			outline-offset: 2px;
		}

		#image-lightbox button svg {
			width: 1.125rem;
			height: 1.125rem;
		}

		@keyframes image-lightbox-in {
			from {
				opacity: 0;
				transform: scale(0.97);
			}
			to {
				opacity: 1;
				transform: scale(1);
			}
		}

		@keyframes image-lightbox-out {
			from {
				opacity: 1;
				transform: scale(1);
			}
			to {
				opacity: 0;
				transform: scale(0.97);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			#image-lightbox[open],
			#image-lightbox.is-closing {
				animation: none;
			}
		}

		#image-lightbox figure {
			margin: 0;
		}

		#image-lightbox img {
			display: block;
			max-width: 100%;
			max-height: calc(90dvh - 4rem);
		}

		#image-lightbox figcaption {
			margin-top: 0.5rem;
			text-align: center;
			color: var(--color-text-secondary);
		}

		@media (min-width: 640px) {
			#blog-content .prose .image-gallery img {
				height: 12rem;
			}
		}
	</style>

	<script>
		document.querySelectorAll('#blog-content .prose :is(h2, h3, h4)[id]').forEach((heading) => {
			heading.addEventListener('click', () => {
				const url = `${window.location.origin}${window.location.pathname}#${heading.id}`;
				navigator.clipboard.writeText(url);
				history.replaceState(null, '', `#${heading.id}`);
			});
		});
	</script>

	<script>
		const lightbox = document.querySelector<HTMLDialogElement>('#image-lightbox');
		const preview = document.querySelector<HTMLImageElement>('#image-lightbox-preview');
		const caption = document.querySelector<HTMLElement>('#image-lightbox-caption');
		const closeButton = document.querySelector<HTMLButtonElement>('#image-lightbox [data-close]');

		if (lightbox && preview && caption) {
			lightbox.addEventListener('close', () => {
				document.documentElement.classList.remove('image-lightbox-open');
			});

			const closeLightbox = () => {
				if (lightbox.classList.contains('is-closing')) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					lightbox.close();
					return;
				}

				lightbox.classList.add('is-closing');
				lightbox.addEventListener(
					'animationend',
					() => {
						lightbox.close();
						lightbox.classList.remove('is-closing');
					},
					{ once: true },
				);
			};

			document
				.querySelectorAll<HTMLAnchorElement | HTMLImageElement>(
					'#blog-content .image-gallery a, #blog-content .prose > p > img',
				)
				.forEach((element) => {
					element.addEventListener('click', (event) => {
						event.preventDefault();
						const image = element instanceof HTMLImageElement ? element : element.querySelector('img');
						if (!image) return;

						preview.src = element instanceof HTMLAnchorElement ? element.href : image.currentSrc || image.src;
						const alt = image.alt;
						preview.alt = alt;
						caption.textContent = alt;
						caption.hidden = !alt;
						lightbox.classList.remove('is-closing');
						document.documentElement.classList.add('image-lightbox-open');
						lightbox.showModal();
						lightbox.focus();
					});
				});

			closeButton?.addEventListener('click', closeLightbox);
			lightbox.addEventListener('click', (event) => {
				if (event.target === lightbox) closeLightbox();
			});
			lightbox.addEventListener('cancel', (event) => {
				event.preventDefault();
				closeLightbox();
			});
		}
	</script>

	<script>
		// navigator.vibrate works during scroll without any AudioContext/user-gesture requirement
		const vibrate = (pattern: number | number[]) => navigator.vibrate?.(pattern);

		const article = document.getElementById('blog-content');

		if (article) {
			const RATCHET_PX = 150;
			const milestones = [0.25, 0.5, 0.75, 1.0];
			// alternating [vibrate, pause, vibrate] patterns — escalating intensity
			const milestonePatterns: (number | number[])[] = [
				15,
				25,
				[15, 30, 25],
				[30, 50, 40],
			];
			const fired = new Set<number>();

			let lastY = window.scrollY;
			let ratchet = 0;

			window.addEventListener('scroll', () => {
				const currentY = window.scrollY;
				ratchet += Math.abs(currentY - lastY);
				lastY = currentY;

				if (ratchet >= RATCHET_PX) {
					vibrate(8);
					ratchet = ratchet % RATCHET_PX;
				}

				const articleTop = article.getBoundingClientRect().top + window.scrollY;
				const progress = Math.min(
					(currentY + window.innerHeight - articleTop) / article.offsetHeight,
					1
				);

				milestones.forEach((m, i) => {
					if (!fired.has(m) && progress >= m) {
						fired.add(m);
						vibrate(milestonePatterns[i]);
					}
				});
			}, { passive: true });
		}
	</script>
</html>
