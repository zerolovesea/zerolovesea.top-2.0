---
import { Header } from "@components/misc";
import { BaseHead } from "@components/seo";
import {
	featuredProjects,
	mergedContributions,
	products,
	socialLinks,
} from "@data/index";
import RootLayout from "@layouts/root-layout.astro";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="ZeroLoveSeA" description="Yang Zhou 的 Python、数据分析与推荐系统项目：CTR/CVR、多任务学习、特征工程、模型评估与工程实践。" />
	</head>
	<RootLayout>
		<div class="flex flex-col w-full gap-6 max-w-2xl">
			<Header />
			<h1 class="w-full text-start text-[min(12vw,72px)] font-medium leading-[0.9] tracking-[-2px] sm:tracking-[-4px]">
				ZeroLoveSeA
				<span class="block text-gray-500 dark:text-gray-400">engineer, trader</span>
			</h1>
			<div class="flex flex-col gap-5 text-lg font-medium leading-relaxed text-gray-700 dark:text-gray-400">
				<p>生于江南水乡，现居苏州，从事精准营销与用户增长相关工作，也开放马德里的工作机会。</p>
				<p>我用 Python 做数据分析、特征工程和推荐系统建模，关注 CTR/CVR 预估、多任务学习、模型评估，以及从训练、推理到应用集成的工程落地。</p>
				<p>我也研究量化低频策略，在这里记录技术探索、交易记录和日常生活。</p>
				<section aria-labelledby="projects-heading" class="flex flex-col gap-4">
					<h2 id="projects-heading" class="text-xl text-gray-900 dark:text-gray-100">技能与项目</h2>
					<ul class="flex flex-col gap-4">
						{featuredProjects.map((project) => (
							<li>
								<a href={project.url} target="_blank" rel="noopener noreferrer" class="text-gray-900 underline underline-offset-4 dark:text-gray-100">{project.name}</a>
								<p class="mt-1 text-base">{project.description.zh}</p>
							</li>
						))}
					</ul>
					<div>
						<h3 class="text-gray-900 dark:text-gray-100">torch-rechub 开源贡献</h3>
						<p class="mt-1 text-base">我提交并已合并的 PR，均包含相应测试：</p>
						<ul class="mt-2 flex flex-col gap-1 text-base">
							{mergedContributions.map((contribution) => (
								<li><a href={contribution.url} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">#{contribution.number} · {contribution.zh}</a></li>
							))}
						</ul>
					</div>
				</section>
				<div>
					<p>我最近在做：</p>
					<div class="mt-4 flex flex-wrap gap-2">
						{products.map((product) => (
							<a
								href={product.url}
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-center gap-2 rounded-full bg-gray-100 py-2 pl-2 pr-4 text-lg text-gray-800 transition-transform duration-200 hover:scale-105 hover:bg-gray-200 active:scale-[0.98] dark:bg-neutral-800 dark:text-gray-100 dark:hover:bg-neutral-700">
								{product.image ? (
									product.imageFit === "contain" ? (
										<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-white">
											<img src={product.image} alt={product.name} class="size-6 object-contain" />
										</span>
									) : (
										<img src={product.image} alt={product.name} class="size-9 rounded-full object-cover" />
									)
								) : (
									<span class="flex size-9 items-center justify-center rounded-full bg-black text-xs font-semibold text-white dark:bg-white dark:text-black">{product.icon}</span>
								)}
								<span>{product.name}</span>
							</a>
						))}
					</div>
				</div>
			</div>
			<div class="flex flex-wrap gap-x-4 gap-y-2">
				{socialLinks.filter((link) => ["github", "linkedin", "kaggle", "email"].includes(link.label)).map((link) => (
					<a
						href={link.url}
						target={link.url.startsWith("mailto:") ? undefined : "_blank"}
						rel={link.url.startsWith("mailto:") ? undefined : "noopener noreferrer"}
						class="text-lg font-medium text-gray-700 hover:underline hover:underline-offset-2 dark:text-gray-400 dark:hover:text-gray-100">
						{link.label}
					</a>
				))}
			</div>
		</div>
	</RootLayout>
</html>
