{
	"name": "sanju.sh",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "bun run astro dev",
		"start": "bun run dev",
		"build": "./node_modules/.bin/astro check && ./node_modules/.bin/astro build",
		"preview": "bun run astro preview",
		"astro": "./node_modules/.bin/astro",
		"new": "bun scripts/new-post.ts",
		"analytics": "bun scripts/analytics-server.ts",
		"studio": "bun scripts/studio-server.ts",
		"studio:macos:build": "bun scripts/studio/macos/build.ts",
		"test:studio": "bun test scripts/studio/*.test.ts",
		"s": "bun run astro dev",
		"d": "bun run build && git add -A && (git diff --cached --quiet || git commit -m \"deploy: update site\") && git push origin main && bunx wrangler deploy --name sanju",
		"test:reading-time": "bun scripts/test-reading-time.ts",
		"check": "biome check ./src",
		"lint": "biome lint ./src",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/mdx": "^7.0.0",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.1",
		"astro": "^7.0.2",
		"katex": "^0.18.1",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"web-haptics": "^0.0.6"
	},
	"devDependencies": {
		"@biomejs/biome": "1.7.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-image": "^3.32.0",
		"@tiptap/extension-table": "^3.32.0",
		"@tiptap/extension-task-item": "^3.32.0",
		"@tiptap/extension-task-list": "^3.32.0",
		"@tiptap/markdown": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"echarts": "^6.1.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1"
	}
}
